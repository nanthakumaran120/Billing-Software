{
  "name": "srinivasa-billing",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "build": "vite build && node -e \"const fs=require('fs');let h=fs.readFileSync('dist/index.html','utf8');fs.writeFileSync('dist/index.html',h.replace(/ crossorigin/g,''));\"",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "express-server": "node server.js",
    "start": "npm run dev",
    "electron-start": "concurrently \"npm run dev\" \"wait-on http://localhost:3005 && electron .\"",
    "electron-pack": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.105.4",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "html2pdf.js": "^0.14.0",
    "json-server": "^1.0.0-alpha.23",
    "lucide-react": "^0.344.0",
    "multer": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.7",
    "written-number": "^0.11.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.srinivasa.billing",
    "productName": "Srinivasa Billing",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Srinivasa Billing"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "server.js"
    ],
    "extraResources": [
      {
        "from": "data/customerdb.json",
        "to": "data/customerdb.json"
      },
      {
        "from": "data/productdb.json",
        "to": "data/productdb.json"
      },
      {
        "from": "data/invoicedb.json",
        "to": "data/invoicedb.json"
      }
    ]
  }
}
